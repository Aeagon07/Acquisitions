# Local non-Docker fallback configuration
# Prefer .env.development for Docker Compose development
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Use Neon Local when running through docker-compose.dev.yml
DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb
NEON_LOCAL=true
NEON_LOCAL_HOST=neon-local
NEON_LOCAL_PORT=5432
NEON_LOCAL_FETCH_ENDPOINT=http://neon-local:5432/sql

# Replace before running against your own Neon project
NEON_API_KEY=napi_83s7xh6h6v1e3nefsmghj036q5a2o9fx1n6s0gzqrypfmne9ii3g2wkgsducq2ut
NEON_PROJECT_ID=raspy-cherry-23766263
PARENT_BRANCH_ID=ep-super-term-a1bco44s
DRIVER=serverless

# Local-only app secrets
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_local_jwt_secret
ARCJET_KEY=replace_with_local_arcjet_key
